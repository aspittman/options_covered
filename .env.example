APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_PAPER=true
# Dry run submits and cancels nothing, including exits.
DRY_RUN=true
ENABLE_NEW_ENTRIES=false
UNDERLYINGS=SPY,QQQ,IWM,DIA
MARKET_SYMBOL=SPY
MARKET_FILTER=true
MIN_DTE=30
MAX_DTE=45
EXIT_DTE=7
TARGET_DELTA=0.25
DELTA_TOLERANCE=0.10
MAX_SPREAD=0.10
MIN_OPEN_INTEREST=500
MIN_VOLUME=100
MIN_CREDIT=0.20
MIN_YIELD=0.002
MAX_CONTRACTS=2
# Virtual allocation is independent of the shared Alpaca account balance.
VIRTUAL_STARTING_CAPITAL=25000
MAX_CONTRACTS_PER_TRADE=1
MAX_UNDERLYING_VALUE_PER_POSITION=25000
# Retained aggregate safety cap; virtual allocation is also enforced.
MAX_COVERED_VALUE=25000
ABOVE_COST_BASIS=true
TAKE_PROFIT=0.50
STOP_MULTIPLE=2.0
MAX_ADX=20
MAX_MA_SLOPE=0.015
MAX_MA_DISTANCE=0.04
MIN_RSI=40
MAX_RSI=60
QUOTE_AGE_SECONDS=120
ENTRY_TIMEOUT_MINUTES=15
EXIT_TIMEOUT_MINUTES=2
COOLDOWN_DAYS=5
INTERVAL=300
OPTION_FEED=indicative
